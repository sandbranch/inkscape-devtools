#!/bin/sh
# Run the host's TeX Live (pdflatex, kpsewhich) inside the Inkscape
# Flatpak: the host's loader and libraries, TeX's trees under /run/host.
# The sandbox does not see the host's /var, where the prebuilt formats
# are, so pdflatex's format is built here, in a folder of ours, and
# rebuilt whenever the host's pdfTeX is newer than it.
prog=$(basename "$0")
H=/run/host
VAR=${XDG_DATA_HOME:-$HOME/.local/share}/inkscape-flatpak/texmf-var
export TEXMFCNF="$H/etc/texmf/web2c:$H/usr/share/texlive/texmf-dist/web2c"
export TEXMFROOT="$H/usr/share/texlive"
export TEXMFDIST="$H/usr/share/texlive/texmf-dist"
export TEXMFMAIN="$H/usr/share/texlive/texmf-dist"
export TEXMFSYSVAR="$VAR"
export TEXMFSYSCONFIG="$H/etc/texmf"
export TEXMFLOCAL="$H/usr/local/share/texmf"
export TEXMFDEBIAN="$H/usr/share/texmf"
# Debian's file indexes (ls-R) hold absolute /usr paths, which are not
# there inside the sandbox: search the trees directly instead.
export TEXMF="{$HOME/texmf,$VAR,$H/usr/local/share/texmf,$H/etc/texmf,$H/usr/share/texmf,$H/usr/share/texlive/texmf-dist}"
export TEXMFDBS=""

run () {
    exec_name=$1; shift
    "$H/usr/lib64/ld-linux-x86-64.so.2" \
        --library-path "$H/usr/lib/x86_64-linux-gnu:$H/lib/x86_64-linux-gnu" \
        "$H/usr/bin/$exec_name" "$@"
}

if [ "$prog" = pdflatex ]; then
    fmt=$VAR/web2c/pdftex/pdflatex.fmt
    engine=$(readlink -f "$H/usr/bin/pdftex" 2>/dev/null || echo "$H/usr/bin/pdftex")
    if [ ! -s "$fmt" ] || [ "$engine" -nt "$fmt" ]; then
        mkdir -p "$VAR/web2c/pdftex"
        (cd "$VAR/web2c/pdftex" &&
         run pdftex -ini -interaction=batchmode -jobname=pdflatex -progname=pdflatex \
             -translate-file=cp227.tcx '*pdflatex.ini' >/dev/null 2>&1) ||
            echo "pdflatex: could not build the LaTeX format in $VAR" >&2
    fi
fi
run "$prog" "$@"
